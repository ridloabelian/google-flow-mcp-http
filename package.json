{
  "name": "google-flow-mcp-http",
  "version": "1.0.0",
  "description": "Plug-and-play Remote MCP Server for Google Flow (flow.google.com) powered by Chrome CDP + Playwright and exposed via MCP Streamable HTTP",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "google-flow-mcp": "dist/index.js"
  },
  "scripts": {
    "setup": "bash ./setup.sh",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --stdio",
    "doctor": "node dist/index.js --doctor --close-hung",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke-test.mjs",
    "cf:provision": "node scripts/provision-cloudflare-rules.mjs"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "playwright-core": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
